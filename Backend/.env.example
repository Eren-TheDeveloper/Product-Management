DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
PORT=3000
NODE_ENV=development
# Comma-separated exact frontend origins, used outside development.
WHITELIST_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_ACCESS_SECRET=replace-with-a-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret
JWT_TOKEN_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Prisma 6.12 URL parameters are added at runtime when missing.
# Explicit DB_* values override existing URL parameters. Durations below are seconds.
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_TIMEOUT_SECONDS=5
DB_SOCKET_TIMEOUT_SECONDS=10

# Startup retries use exponential backoff with jitter. Attempts include the first try.
DB_CONNECT_ATTEMPTS=5
DB_RETRY_DELAY_MS=500
DB_RETRY_MAX_DELAY_MS=5000

# At most one retry for a standalone read; writes and transactions are never replayed.
DB_READ_ATTEMPTS=2
DB_READ_RETRY_DELAY_MS=150
DB_TRANSACTION_MAX_WAIT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=20000
